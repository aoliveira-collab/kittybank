{
  "name": "@kittybank/react",
  "version": "1.0.1",
  "type": "module",
  "description": "Componentes React do design system KittyBank e templates Code Connect parserless",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoliveira-collab/kittybank.git"
  },
  "homepage": "https://github.com/aoliveira-collab/kittybank#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kittybank.js"
    },
    "./styles.css": "./dist/kittybank.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "KittyBank-Guidelines.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:catalog": "vite build --mode catalog",
    "typecheck": "tsc --noEmit && tsc -p code-connect/tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "tokens:build": "node scripts/build-tokens.mjs",
    "connect:parse": "node scripts/parse-code-connect.mjs",
    "connect:publish": "figma connect publish --config figma.config.json",
    "connect:check": "node scripts/check-code-connect.mjs",
    "format": "prettier --write src catalog code-connect tests scripts/*.mjs *.json *.ts README.md",
    "format:check": "prettier --check src catalog code-connect tests scripts/*.mjs *.json *.ts README.md",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.0"
  },
  "devDependencies": {
    "@figma/code-connect": "2.0.2",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.0",
    "prettier": "3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
